#!/usr/bin/env bash
set -euo pipefail
source_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
data_dir="${XDG_DATA_HOME:-$HOME/.local/share}"
prefix="$data_dir/television"
gui=false
while (( $# )); do
  case "$1" in
    --prefix) [[ $# -ge 2 ]] || exit 2; prefix="$2"; shift 2 ;;
    --gui) gui=true; shift ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
done
fail() {
  echo "$1" >&2
  if [[ "$gui" == true ]] && command -v zenity >/dev/null; then zenity --error --text="$1" || true; fi
  exit 1
}
[[ "$(uname -m)" == x86_64 ]] || fail "This Television build requires x86_64 Linux."
[[ "$prefix" == /* && "$data_dir" == /* ]] || fail "Installation paths must be absolute."
[[ "$prefix" != / && "$prefix" != "$HOME" && "$prefix" != "$data_dir" ]] || fail "Choose a dedicated Television installation folder."
[[ -f "$source_dir/television" && -f "$source_dir/resources/app.asar" && -f "$source_dir/television.png" ]] || fail "Keep the complete Television archive together before installing."
[[ "$source_dir" != "$prefix" ]] || fail "Television is already in the selected installation folder."
if [[ -d "$prefix" && ! -f "$prefix/.television-linux-install" ]]; then
  [[ -z "$(ls -A -- "$prefix")" ]] || fail "The selected folder contains unrelated files. Choose a new Television folder."
fi
mkdir -p "$prefix" "$data_dir/applications" "$data_dir/icons/hicolor/512x512/apps"
cp -a -- "$source_dir/." "$prefix/"
printf 'Television Linux user installation\n' > "$prefix/.television-linux-install"
chmod +x "$prefix/television" "$prefix/television-launcher"
# Desktop Exec has its own quoting rules, followed by reserved characters
# inside double quotes. Percent is escaped so paths cannot introduce codes.
desktop_quote() {
  local value="$1"
  value="${value//\\/\\\\\\\\}"; value="${value//\"/\\\\\"}"
  value="${value//\$/\\\\\$}"; value="${value//\`/\\\\\`}"
  value="${value//%/%%}"
  printf '%s' "$value"
}
exec_path="$(desktop_quote "$prefix/television-launcher")"
entry="$data_dir/applications/computer.telepath.television.desktop"
cat > "$entry" <<EOF
[Desktop Entry]
Type=Application
Name=Television
Comment=Visual artifacts for your personal agent
Exec=bash "$exec_path" %U
Icon=computer.telepath.television
Terminal=false
Categories=Utility;Development;
StartupWMClass=computer.telepath.television
EOF
cp "$prefix/television.png" "$data_dir/icons/hicolor/512x512/apps/computer.telepath.television.png"
if command -v update-desktop-database >/dev/null; then update-desktop-database "$data_dir/applications" || true; fi
if command -v gtk-update-icon-cache >/dev/null; then gtk-update-icon-cache -f -t "$data_dir/icons/hicolor" >/dev/null 2>&1 || true; fi
message="Television is installed. Open Television from your application launcher and paste the connect link supplied by your agent."
echo "$message"
if [[ "$gui" == true ]]; then
  if command -v zenity >/dev/null; then zenity --info --title="Television installed" --text="$message" || true
  elif command -v notify-send >/dev/null; then notify-send "Television installed" "$message" || true
  fi
fi
